{
  "compilerOptions": {
    "composite": true, "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "strict": true, "noEmit": true, "types": ["node"], "esModuleInterop": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "server/**/*.ts", "src/**/*.ts"]
}