{
  "name": "live-teacher-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nepali-first, timeline-driven 3D teaching studio with swappable AI/TTS providers.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-server": "tsx server/mock-server.ts",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.2.6",
    "three": "^0.180.0",
    "zod": "^4.1.12",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4",
    "@types/express": "^5.0.3"
  }
}